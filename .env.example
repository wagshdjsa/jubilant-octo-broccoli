# ===== 基础设施 =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agent_platform
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_pwd
DATABASE_URL=postgresql+psycopg2://agent:agent_pwd@postgres:5432/agent_platform

REDIS_URL=redis://redis:6379/0

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ===== 模型网关 (model-svc) =====
# 当前上游：智谱 GLM（OpenAI 兼容端点）
OPENAI_API_BASE=https://open.bigmodel.cn/api/paas
# Key 在这里粘贴（不要 commit，不要贴到聊天）：
OPENAI_API_KEY=
MODEL_DEFAULT_ALIAS=chat-default
# 默认模型名（启动时 model-svc 自动注册的默认别名指向的模型）
ZHIPU_DEFAULT_MODEL=glm-4-flash
# Embedding 模型（智谱提供 OpenAI 兼容 embedding 端点）
ZHIPU_EMBEDDING_MODEL=embedding-2

# ===== LangSmith（可选，不填则不上报 trace） =====
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agent-platform-dev

# ===== 管理 Token（admin API） =====
# 自己设一个复杂串，登录管理后台要用
MANAGER_ADMIN_TOKEN=ChangeMe!2026

# ===== 服务端口 =====
API_GATEWAY_PORT=8000
AGENT_MANAGER_PORT=8001
AGENT_RUNTIME_PORT=8002
KNOWLEDGE_PORT=8003
TOOL_PORT=8004
MODEL_PORT=8005